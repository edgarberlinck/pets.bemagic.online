# PostgreSQL: use a pooled TLS connection in production.
DATABASE_URL=
# Canonical origin, including https:// in production; no trailing slash.
NEXTAUTH_URL=http://localhost:3000
# Generate locally: openssl rand -base64 32
NEXTAUTH_SECRET=
# Verify a sending domain in Resend. Never put these in NEXT_PUBLIC variables.
RESEND_API_KEY=
EMAIL_FROM=
# Generate locally: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Generate locally: openssl rand -hex 32
CRON_SECRET=
