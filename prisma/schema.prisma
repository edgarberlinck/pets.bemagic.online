generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  emailVerified     DateTime?
  role              Role     @default(USER)
  blocked           Boolean  @default(false)
  sessionVersion    Int      @default(0)
  suspiciousScore   Int      @default(0)
  suspiciousReasons String[] @default([])
  reviewedAt        DateTime?
  failedLoginCount   Int      @default(0)
  lastFailedLoginAt  DateTime?
  createdAt         DateTime @default(now())
  pet               Pet?
  pushSubscriptions PushSubscription[]
  verificationTokens VerificationToken[]

  @@index([role, blocked])
  @@index([suspiciousScore, createdAt])
}

model Pet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  species         String   @default("blob")
  hunger          Float    @default(80)
  happiness       Float    @default(80)
  energy          Float    @default(80)
  cleanliness     Float    @default(80)
  version         Int      @default(0)
  theme           String   @default("meadow")
  petColor        String   @default("#a78bfa")
  backgroundColor String   @default("#ecfdf5")
  lastActionAt    DateTime?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model PushSubscription {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint       String   @unique
  p256dh         String
  auth           String
  lastNotifiedAt DateTime?
  createdAt      DateTime @default(now())

  @@index([userId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key     String   @id
  hits    Int
  resetAt DateTime

  @@index([resetAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
}
